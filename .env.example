# Copy to .env (never commit .env). Loaded by playwright.config.js via dotenv.

# --- AI self-healing locators ------------------------------------------------
# Master switch. Off by default: nothing is sent to any AI provider unless "true".
AI_HEALING_ENABLED=false
# Minimum AI confidence (0..1) required before a replacement locator is used.
AI_HEALING_MIN_CONFIDENCE=0.90

# OpenAI provider. If either is missing, healing fails safely with the original error.
OPENAI_API_KEY=
# Any OpenAI chat model that supports structured outputs (json_schema).
AI_HEALING_MODEL=

# Optional tuning
# AI_HEALING_TIMEOUT_MS=15000          # max time for the single AI call
# AI_HEALING_ACTION_TIMEOUT_MS=5000    # original action + retry timeout when healing is on
# AI_HEALING_MAX_CANDIDATES=40         # max DOM candidates sent to the AI
# AI_HEALING_SCREENSHOTS=false         # masked before/after screenshots in the HTML report
# AI_HEALING_REPORT_DIR=healing-reports

# Opt-in real AI integration test (npm run test:healing:real sets this for you)
# AI_HEALING_REAL_TEST=false
